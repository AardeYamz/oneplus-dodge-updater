{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dodge Toolbox",
  "identifier": "local.dodge.toolbox",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Dodge Toolbox", "width": 1100, "height": 780 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; font-src data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
