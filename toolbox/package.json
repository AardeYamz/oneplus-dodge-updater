{
  "name": "dodge-toolbox",
  "version": "0.1.0",
  "description": "Windows toolbox for updating LineageOS on the OnePlus 13 (dodge)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "theme": "node fetch-theme.js",
    "prestart": "npm run theme",
    "start": "electron .",
    "predist": "npm run theme",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.dodge.toolbox",
    "productName": "Dodge Toolbox",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "theme/*"
    ],
    "win": {
      "target": "portable",
      "icon": "theme/icon.png"
    },
    "icon": "theme/icon.png"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "sharp": "^0.35.5"
  }
}
