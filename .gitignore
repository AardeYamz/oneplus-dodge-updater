# --- Flashing artifacts: ROM/recovery/GApps/module packages and flashed images ---
# These are large downloads (single zips 0.5-7.8 GB) and are reproducible from the
# build pages, so they stay out of version control.
*.zip
*.img
*.apk

# --- Downloaded tool bundles and extracted recovery contents ---
platform-tools/
fox-extract/

# --- Freebuff Desktop project state (holds this folder's project-id) ---
.freebuff/

# --- Local tool/editor settings ---
.claude/settings.local.json

# --- OS cruft ---
Thumbs.db
desktop.ini
.DS_Store

# --- Toolbox app build output ---
toolbox/node_modules/
toolbox/dist/
