# --- Downloads and flash artifacts (ROM/GApps/recovery zips, images, tool bundles) ---
# Large (single zips 0.5-7.8 GB) and reproducible from the build pages, so they stay out
# of version control.
artifacts/*
platform-tools/
*.zip
*.img
*.apk

# --- Freebuff Desktop project state (holds this folder's project-id) ---
.freebuff/

# --- Local config (see .env.example) ---
.env

# --- Local tool/editor settings ---
.claude/settings.local.json

# --- OS cruft ---
Thumbs.db
desktop.ini
.DS_Store

# --- Toolbox app build output ---
toolbox/target/
# Rendered from the theme's favicon.svg by toolbox/build.rs
toolbox/icons/
# Generated by tauri-build
toolbox/gen/
# Portable exe copied to the repo root by scripts/build-toolbox.ps1
Dodge Toolbox *.exe

# Fetched by toolbox/build.rs from the pinned yl-theme version (toolbox/theme.json)
toolbox/ui/theme/

# Licensed Calibre / SF Mono fonts: local builds only, never committed. Optional: the link in index.html is skipped if missing.
toolbox/ui/theme/yl-fonts.css
/toolbox/node_modules
